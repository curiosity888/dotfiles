#!/usr/bin/env bash
# handbook: справочник из ~/handbook через fzf
#   handbook     — список файлов с glow-превью
#   handbook -g  — live-grep по содержимому (как <leader>ps в nvim)
# В обоих режимах Ctrl+G переключает файлы <-> grep.

HANDBOOK_DIR="$HOME/handbook"

# --- режим grep: набранный текст = запрос к rg, список обновляется на лету ---
grep_mode() {
    cd "$HANDBOOK_DIR" || exit 1
    local rg_cmd="rg --line-number --no-heading --color=always --smart-case"
    local out
    out=$(fzf \
        --reverse --ansi --disabled \
        --prompt 'grep> ' \
        --header 'Ctrl+G — к списку файлов' \
        --bind "start:reload:$rg_cmd ''" \
        --bind "change:reload:$rg_cmd {q} || true" \
        --bind 'ctrl-g:become(handbook)' \
        --delimiter : \
        --preview 'bat --color=always --style=plain --highlight-line {2} {1}' \
        --preview-window 'right,55%,+{2}/2')

    [[ -z $out ]] && exit 0
    local file line
    file=${out%%:*}
    line=$(cut -d: -f2 <<< "$out")

    # открываем на найденной строке: bat подсвечивает, less прыгает к ней
    bat --paging=always --style=plain --color=always \
        --highlight-line "$line" \
        --pager "less -R +${line}g" \
        "$file"
    exit 0
}

[[ $1 == "-g" ]] && grep_mode

# --- режим по умолчанию: выбор файла ---
selected=$(find "$HANDBOOK_DIR" -name '*.md' | sort | fzf \
    --reverse \
    --prompt 'handbook> ' \
    --header 'Ctrl+G — grep по содержимому' \
    --bind 'ctrl-g:become(handbook -g)' \
    --delimiter / --with-nth -1 \
    --preview 'glow -s dark -w $FZF_PREVIEW_COLUMNS {}' \
    --preview-window 'right,70%')

# Esc — выходим молча
[[ -z $selected ]] && exit 0

# -p: пейджер с прокруткой
glow -p "$selected"
